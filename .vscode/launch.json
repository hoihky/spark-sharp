{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SparkScriptHost (HelloCsGame Debug)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/native/SparkScriptHost",
      "args": [
        "${workspaceFolder}/scripting/samples/HelloCsGame/bin/Debug/net8.0/HelloCsGame.runtimeconfig.json",
        "${workspaceFolder}/scripting/samples/HelloCsGame/bin/Debug/net8.0/HelloCsGame.dll"
      ],
      "cwd": "${input:sparkEngineRootLaunch}",
      "env": {
        "DYLD_LIBRARY_PATH": "${workspaceFolder}/build/native",
        "LD_LIBRARY_PATH": "${workspaceFolder}/build/native"
      },
      "preLaunchTask": "spark-sharp: build host + HelloCsGame (Debug)"
    },
    {
      "name": "Attach .NET to SparkScriptHost",
      "type": "coreclr",
      "request": "attach",
      "processName": "SparkScriptHost"
    }
  ],
  "inputs": [
    {
      "id": "sparkEngineRootLaunch",
      "type": "promptString",
      "description": "Working directory (Spark engine repo with assets/)",
      "default": "${workspaceFolder}/../spark"
    }
  ]
}
